# 图像算法服务配置模板。
# 真实配置文件不得提交版本库。

# MySQL 连接（数据库尚未建表时，仅用于后续服务接入）。
MYSQL_HOST=10.10.20.120:3306
MYSQL_PORT=3306
MYSQL_USER=<mysql_user>
MYSQL_PASSWORD=<mysql_password>
MYSQL_DATABASE=<mysql_database>
DATABASE_URL=mysql+pymysql://<mysql_user>:<mysql_password>@<mysql_host>:3306/<mysql_database>?charset=utf8mb4

# 进程内 Python 队列：不使用 Redis、Celery 或任何外部消息队列。
# GPU 推理建议保持 1，避免同一张 GPU 并发导致显存不足。
PYTHON_QUEUE_NAME=heart_algo_python_gpu
PYTHON_QUEUE_WORKERS=<number_of_parallel_api_queue_workers>
# 可用 GPU 编号，多个编号用英文逗号分隔；模型任务自动领取空闲 GPU。
PYTHON_GPU_IDS=0,1
PYTHON_QUEUE_MAX_SIZE=0